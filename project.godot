; Archivo de configuración del motor Godot.
; Río Limpio - Proyecto de Programación para Videojuegos

config_version=5

[application]

config/name="EcoGuardián"
config/description="EcoGuardián: recolector de basura top-down en dos niveles. Limpia los ríos de Caldas clasificando residuos con el código de colores de Colombia."
config/version="1.0"
run/main_scene="res://Escenas/MenuPrincipal.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://Assets/icono.png"

[autoload]

Guardado="*res://Scripts/Globales/guardado.gd"
Sonido="*res://Scripts/Globales/sonido.gd"
Transicion="*res://Escenas/Interfaz/Transicion.tscn"
Evaluacion="*res://Scripts/Globales/evaluacion.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://Assets/tema.tres"

