[node name="Controles" type="Label" parent="PanelAyuda/Contenido"]
layout_mode = 2
text = "Moverse: WASD o flechas  ·  Depositar: E  ·  Elegir residuo: Q, Tab o 1-2-3
Burbujas de jabón: Espacio o clic  ·  Pausa: Esc  ·  Reiniciar: R  ·  Sonido: M"
label_settings = SubResource("Texto_pequeno")
horizontal_alignment = 1

[node name="Reglas" type="Label" parent="PanelAyuda/Contenido"]
layout_mode = 2
text = "Recoge la basura del suelo y del río (máximo 3 en la mochila) y llévala a su caneca. Acierto: +10. Error: -5. Combo de 3 aciertos: +15. La basura sin recoger contamina el río: si llega a 100 % pierdes. Nivel 1: recicla 12. Nivel 2 (el pueblo): recicla 15 y cuidado con las bolsas voladoras, ¡te quitan residuos!"
label_settings = SubResource("Texto_pequeno")
horizontal_alignment = 1
autowrap_mode = 3

